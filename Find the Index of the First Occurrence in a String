class Solution {
    public int strStr(String haystack, String needle) {

        int n = haystack.length();
        int m = needle.length();

        // Edge case
        if (m > n) return -1;

        // Loop through haystack
        for (int i = 0; i <= n - m; i++) {

            int j = 0;

            // Compare characters
            while (j < m && haystack.charAt(i + j) == needle.charAt(j)) {
                j++;
            }

            // If full match found
            if (j == m) {
                return i;
            }
        }

        return -1;
    }
}
