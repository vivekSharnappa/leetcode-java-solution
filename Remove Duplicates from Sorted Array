class Solution {
    public int removeDuplicates(int[] nums) {
        // Edge case
        if (nums.length == 0) return 0;

        int i = 0; // pointer for unique elements

        for (int j = 1; j < nums.length; j++) {
            // If new unique element found
            if (nums[j] != nums[i]) {
                i++;
                nums[i] = nums[j];
            }
        }

        // Number of unique elements = i + 1
        return i + 1;
    }
}
